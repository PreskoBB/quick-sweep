<UserControl x:Class="QuickSweep.Ui.ExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QuickSweep.Ui">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="RootBox" Width="250" SelectionChanged="OnRootChanged"/>
                <Button x:Name="ScanButton" Grid.Column="1" Content="Scan" Style="{StaticResource AccentButton}" Padding="18,7" Margin="10,0,0,0" Click="OnScan"/>
                <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Status" Style="{StaticResource Body}" Text="Pick a drive or folder and press Scan. Read-only: nothing is changed."/>
                    <TextBlock x:Name="Sub" Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None"
                               Text="A full-drive scan makes Windows cache millions of file names (the kernel pool on the Memory page). It is harmless cache; a restart clears it."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,8,0,0" Height="560">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="10,8,10,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                        <Button Content="Name" Tag="Name" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="4,2" Click="OnSort"/>
                        <Button Grid.Column="1" Content="Size" Tag="Size" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="4,2" Click="OnSort"/>
                        <Button Grid.Column="2" Content="%" Tag="Size" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="4,2" Click="OnSort"/>
                        <Button Grid.Column="3" Content="Files" Tag="Files" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="4,2" Click="OnSort"/>
                    </Grid>
                    <ListView x:Name="Tree" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="OnTreeSelect" MouseDoubleClick="OnTreeDouble"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,0,10,0" Height="26">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="56"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Toggle}" Width="16" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Tag="{Binding}" MouseLeftButtonUp="OnToggleClick" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="12.5" ToolTip="{Binding Path}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Body}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PctText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FilesText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UpButton" Content="Up" Style="{StaticResource PillButton}" Padding="12,4" Click="OnUp" IsEnabled="False"/>
                        <TextBlock x:Name="Crumb" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" Content="Show in Explorer" Style="{StaticResource GhostButton}" Padding="8,4" Click="OnShow"/>
                    </Grid>
                    <ui:TreemapView x:Name="Map" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
