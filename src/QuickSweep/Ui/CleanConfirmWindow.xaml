<Window x:Class="QuickSweep.Ui.CleanConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="760" Height="600" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadText" Style="{StaticResource PageTitle}" FontSize="20" TextWrapping="Wrap"/>
            <TextBlock x:Name="Sub" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border x:Name="WarnBox" Background="#3A2F14" BorderBrush="#6B5420" BorderThickness="1" CornerRadius="8" Padding="12,8" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock x:Name="WarnText" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <CheckBox x:Name="RecycleAll" Style="{StaticResource Switch}" Content="Send everything to the Recycle Bin instead (does not free space until you empty it)"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="4">
            <ListView x:Name="PathList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding NoteBrush}" Visibility="{Binding NoteVis}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="6,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding How}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <StackPanel x:Name="TypeBox" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TypeLabel" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBox x:Name="TypeInput" Margin="0,6,0,0" Width="220" HorizontalAlignment="Left" TextChanged="OnTypeChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource PillButton}" Padding="18,8" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"/>
            <Button x:Name="Confirm" Style="{StaticResource DangerButton}" Padding="18,8" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
