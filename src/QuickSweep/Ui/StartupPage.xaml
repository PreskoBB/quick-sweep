<UserControl x:Class="QuickSweep.Ui.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Startup apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" TextTrimming="None"
                       Text="The same switch as Task Manager's Startup tab (the StartupApproved keys). Nothing is deleted: turn it back on any time. A change applies at your next sign-in."/>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="SumTitle" Style="{StaticResource BigNumber}" FontSize="26"/>
                        <TextBlock x:Name="SumLine" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="List" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,10" Opacity="{Binding Fade}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Faint}" ToolTip="{Binding Command}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="in RAM now" Style="{StaticResource Faint}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanChange}"
                                          Tag="{Binding}" Click="OnToggle" VerticalAlignment="Center" ToolTip="{Binding SwitchTip}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Footer" Style="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
