<UserControl x:Class="QuickSweep.Ui.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Disk cleaner" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap" TextTrimming="None"
                       Text="Find what is safe to clean and where the space went. Dry run is on by default: nothing is deleted until you turn it off, tick items and confirm the exact list."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="TabClean" Content="Safe to clean" Style="{StaticResource NavItem}" Width="150" IsChecked="True" GroupName="disktab" Checked="OnTab"/>
                <RadioButton x:Name="TabExplore" Content="Biggest folders" Style="{StaticResource NavItem}" Width="150" GroupName="disktab" Checked="OnTab"/>
            </StackPanel>
            <ContentControl x:Name="Host"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
