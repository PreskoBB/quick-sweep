<UserControl x:Class="QuickSweep.Ui.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QuickSweep.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Where did my RAM go" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Task Manager lists apps. This page adds everything else Windows holds memory for, in plain words."
                       Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" TextTrimming="None"/>

            <!-- physical -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Physical memory" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="PhysTotal" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ui:StackBar x:Name="PhysBar" Margin="0,12,0,10"/>
                    <ItemsControl x:Name="Legend">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1,12,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- commit -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Committed memory" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="CommitText" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ui:BarMeter x:Name="CommitBar" Margin="0,10,0,8"/>
                    <TextBlock x:Name="CommitVerdict" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="Commit is memory Windows has promised to programs, backed by RAM or the page file. It is a promise, not RAM in use. If it reaches the limit (RAM plus page file), programs start failing to allocate memory even while RAM looks free."/>
                </StackPanel>
            </Border>

            <!-- kernel -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Windows kernel memory (pool)" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="PoolTotal" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="PoolVerdict" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PoolSplit" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"
                               Text="The kernel pool is cache the Windows kernel and drivers keep: file names, NTFS records, Defender scan data. It is normally 1 to 3 GB. Scanning huge folders (backups, git, disk-usage tools) makes it balloon, and it does not shrink by itself. It is not an app leaking; a restart resets it."/>
                    <TextBlock x:Name="PoolTagsTitle" Text="Biggest users right now" Style="{StaticResource SectionTitle}" FontSize="12" Margin="0,12,0,4"/>
                    <ItemsControl x:Name="PoolList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Tag}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Meaning}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Body}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PoolTagsNote" Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- apps -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Apps" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="private memory, every process of an app added together" Style="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="AppList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36">
                                    <Grid Visibility="{Binding NormalVis}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Faint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CommitText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <Button Grid.Column="4" Content="End" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" HorizontalAlignment="Right"
                                                Visibility="{Binding EndVis}" Tag="{Binding}" Click="OnEndClick"/>
                                    </Grid>
                                    <Grid Visibility="{Binding ConfirmVis}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ConfirmText}" Foreground="{StaticResource WarnBrush}" FontSize="13" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="End now" Style="{StaticResource DangerButton}" Padding="10,4" Margin="6,0,6,0" Tag="{Binding}" Click="OnEndConfirm"/>
                                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource PillButton}" Padding="10,4" Tag="{Binding}" Click="OnEndCancel"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
