<UserControl x:Class="QuickSweep.Ui.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Drive health" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap" TextTrimming="None"
                       Text="SMART status, wear, temperature and bad-sector counts of every drive. Quick Sweep compares them with the first reading and warns when a drive gets worse."/>

            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="CheckButton" Content="Check now" Style="{StaticResource AccentButton}" Padding="18,7" Click="OnCheck"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    <Button Grid.Column="2" Content="Accept today's numbers as normal" Style="{StaticResource GhostButton}" Click="OnAccept" ToolTip="Forget earlier readings (for example after replacing a cable)"/>
                </Grid>
            </Border>

            <ItemsControl x:Name="List" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="18,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="15"/>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="11" Padding="12,3" Background="{Binding ChipBg}" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Chip}" Foreground="{Binding ChipFg}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,12,0,0" Visibility="{Binding StatsVis}">
                                    <StackPanel Margin="0,0,8,8"><TextBlock Text="Temperature" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Temp}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,8,8"><TextBlock Text="Life left" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Life}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,8,8"><TextBlock Text="Reallocated sectors" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Realloc}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Pending / uncorrectable" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Pending}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Power-on time" Style="{StaticResource Faint}"/><TextBlock Text="{Binding PowerOn}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Written (SSD)" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Written}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Interface errors" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Crc}" Style="{StaticResource Body}" TextTrimming="None"/></StackPanel>
                                    <StackPanel><TextBlock Text="Wear source" Style="{StaticResource Faint}"/><TextBlock Text="{Binding LifeSource}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding Findings}" Visibility="{Binding FindingsVis}" Foreground="{Binding ChipFg}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVis}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                                <Expander Header="All SMART attributes" Visibility="{Binding StatsVis}" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                    <ItemsControl ItemsSource="{Binding Attrs}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Faint}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTip="Normalised value (higher is better)"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Worst}" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTip="Worst value seen"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Threshold}" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTip="Failure threshold"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Raw}" Style="{StaticResource Caption}" HorizontalAlignment="Right" ToolTip="Raw value"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
