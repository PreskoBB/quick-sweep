<UserControl x:Class="QuickSweep.Ui.CleanerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- toolbar -->
        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButton}" Padding="18,7" Click="OnScan"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource Body}" Text="Measures every category without changing anything."/>
                    <TextBlock x:Name="ScanSub" Style="{StaticResource Faint}" Visibility="Collapsed"/>
                </StackPanel>
                <CheckBox x:Name="DryRunSwitch" Grid.Column="2" Style="{StaticResource Switch}" Content="Dry run (nothing is deleted)" IsChecked="True" Click="OnDryRunChanged" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="SummaryCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FoundText" Style="{StaticResource BigNumber}" FontSize="22"/>
                    <TextBlock x:Name="SelectedText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select all safe" Style="{StaticResource PillButton}" Click="OnSelectSafe" Margin="0,0,8,0"/>
                    <Button Content="Clear" Style="{StaticResource PillButton}" Click="OnClear" Margin="0,0,8,0"/>
                    <Button x:Name="CleanButton" Content="Review and clean..." Style="{StaticResource DangerButton}" Padding="14,7" Click="OnClean" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0" Visibility="Collapsed" Background="#223A2A" BorderBrush="#2F5F3C">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ItemsControl x:Name="CategoryList" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="0">
                        <StackPanel>
                            <Grid Margin="14,11,14,11" Background="Transparent" MouseLeftButtonUp="OnHeaderClick" Tag="{Binding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="92"/><ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding AllSelected, Mode=OneWay}" IsEnabled="{Binding CanSelect}" Tag="{Binding}" Click="OnCategoryCheck" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Faint}"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center" Background="{Binding BadgeBg}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{Binding BadgeFg}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TotalText}" Style="{StaticResource Body}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Arrow}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Visibility="{Binding BodyVis}">
                                <Rectangle Height="1" Fill="{StaticResource StrokeBrush}"/>
                                <StackPanel Margin="44,10,14,6">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None">
                                        <Run Text="What it is: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding What, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0">
                                        <Run Text="Why it is safe: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding WhySafe, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0">
                                        <Run Text="If it comes back: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding Regen, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DeleteHow}" Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Shown}" Margin="14,4,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Selectable}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding PathTip}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Flags}" Foreground="{Binding FlagBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,8,0" ToolTip="{Binding FlagTip}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreText}" Visibility="{Binding MoreVis}" Style="{StaticResource Faint}" Margin="44,2,14,0"/>
                                <Button Visibility="{Binding ManagedVis}" Content="Open Windows Disk Cleanup" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="44,6,14,0" Click="OnOpenCleanmgr"/>
                                <Rectangle Height="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
