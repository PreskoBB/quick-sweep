<Window x:Class="QuickSweep.Ui.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickSweep.Ui"
        Title="Quick Sweep" Width="384" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{StaticResource BgBrush}" ThemeMode="None"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="Manual">
    <Border x:Name="Root" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Border.RenderTransform><TranslateTransform x:Name="Slide" Y="0"/></Border.RenderTransform>
        <StackPanel Margin="14,12,14,14">

            <!-- header -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/quicksweep.ico" Width="20" Height="20"/>
                    <TextBlock Text="Quick Sweep" Style="{StaticResource SectionTitle}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="StatusPill" HorizontalAlignment="Right" CornerRadius="11" Padding="10,3" Background="#223A2A">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="All good" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl x:Name="AlertList" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A2F14" BorderBrush="#6B5420" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CPU + GPU -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CpuTemp" Text="--" Style="{StaticResource BigNumber}"/>
                            <TextBlock x:Name="CpuUnit" Text="°C" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Top" Margin="2,7,0,0"/>
                        </StackPanel>
                        <ui:Sparkline x:Name="CpuSpark" Height="24" Margin="0,2,0,6" Min="30" Max="80"/>
                        <TextBlock x:Name="CpuLine" Text="Load 0%" Style="{StaticResource Caption}"/>
                        <ui:BarMeter x:Name="CpuBar" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CpuNote" Text="" Style="{StaticResource Faint}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="GpuName" Text="GPU" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GpuTemp" Text="--" Style="{StaticResource BigNumber}"/>
                            <TextBlock Text="°C" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Top" Margin="2,7,0,0"/>
                        </StackPanel>
                        <ui:Sparkline x:Name="GpuSpark" Height="24" Margin="0,2,0,6" Min="30" Max="80"/>
                        <TextBlock x:Name="GpuLine" Text="Load 0%" Style="{StaticResource Caption}"/>
                        <ui:BarMeter x:Name="GpuBar" Margin="0,6,0,0"/>
                        <TextBlock x:Name="VramLine" Text="VRAM" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <ui:BarMeter x:Name="VramBar" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- memory -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Memory" Style="{StaticResource SectionTitle}"/>
                        <Button x:Name="MemDetails" Content="Where did it go?" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="6,0" FontSize="11" Click="OnMemDetails"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="RamLine" Text="RAM" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="RamPct" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ui:BarMeter x:Name="RamBar" Margin="0,4,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="CommitLine" Text="Committed" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="CommitPct" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ui:BarMeter x:Name="CommitBar" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- storage -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Storage" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="UptimeText" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl x:Name="DriveList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Letter}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:BarMeter Grid.Column="1" Value="{Binding Used}" Fill="{Binding Fill}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FreeText}" Foreground="{Binding TextBrush}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- game mode -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="GameSwitch" Style="{StaticResource Switch}" Click="OnGameSwitch" HorizontalAlignment="Stretch">
                        <TextBlock Text="Game Mode: slow background work only when the game needs it" Style="{StaticResource SectionTitle}"
                                   TextWrapping="Wrap" Width="276"/>
                    </CheckBox>
                    <TextBlock x:Name="GameLine" Text="Waiting for a game" Style="{StaticResource Caption}" Margin="48,5,0,0"
                               TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </Border>

            <!-- top memory apps -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Top memory" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="grouped per app" Style="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="AppList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34">
                                    <Grid Visibility="{Binding NormalVis}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"/>
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Faint}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                        <Button Grid.Column="3" Content="End" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" HorizontalAlignment="Right"
                                                Visibility="{Binding EndVis}" Tag="{Binding}" Click="OnEndClick" ToolTip="End every process of this app"/>
                                    </Grid>
                                    <Grid Visibility="{Binding ConfirmVis}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ConfirmText}" Foreground="{StaticResource WarnBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="End now" Style="{StaticResource DangerButton}" Padding="8,3" FontSize="11" Margin="6,0,4,0" Tag="{Binding}" Click="OnEndConfirm"/>
                                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource PillButton}" Padding="8,3" FontSize="11" Tag="{Binding}" Click="OnEndCancel"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Open Quick Sweep" Style="{StaticResource AccentButton}" Padding="12,8" Click="OnOpenMain"/>
                <Button Grid.Column="2" Content="Sessions" Style="{StaticResource PillButton}" Padding="14,8" Click="OnOpenSessions"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
