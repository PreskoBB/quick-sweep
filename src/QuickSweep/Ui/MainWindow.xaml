<Window x:Class="QuickSweep.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Sweep" Width="1080" Height="720" MinWidth="880" MinHeight="560"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" Icon="/Assets/quicksweep.ico">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#18191D" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                    <Image Source="/Assets/quicksweep.ico" Width="24" Height="24"/>
                    <TextBlock Text="Quick Sweep" Style="{StaticResource SectionTitle}" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                    <TextBlock x:Name="ElevText" Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
                <StackPanel x:Name="NavPanel"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
