<UserControl x:Class="QuickSweep.Ui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="SwGameAuto" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Game Mode: slow background work only when the game needs it" Click="OnChanged"/>
                    <CheckBox x:Name="SwGameNotify" Style="{StaticResource Switch}" Margin="0,10,0,0" Content="Quiet notification when Game Mode kicks in (at most once per game)" Click="OnChanged"/>
                    <CheckBox x:Name="SwNotify" Style="{StaticResource Switch}" Margin="0,10,0,0" Content="Quiet notification when a game closes (session saved)" Click="OnChanged"/>
                    <CheckBox x:Name="SwAlerts" Style="{StaticResource Switch}" Margin="0,10,0,0" Content="Alerts when something is really wrong (heat, full C:, leaks)" Click="OnChanged"/>
                    <CheckBox x:Name="SwPing" Style="{StaticResource Switch}" Margin="0,10,0,0" Content="Ping monitor (one packet every few seconds to the router and 1.1.1.1)" Click="OnChanged"/>
                    <TextBlock Text="Quick Sweep never plays sounds and never pops anything up while you play." Style="{StaticResource Faint}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Alert limits" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="CPU temperature above (°C)" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbCpu" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="GPU temperature above (°C)" Grid.Row="1" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGpu" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Free space below (GB)" Grid.Row="2" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TbSpace" Grid.Row="2" Grid.Column="1" LostFocus="OnChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Game Mode: when does it act?" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,10" TextWrapping="Wrap" TextTrimming="None"
                               Text="While a game runs, background work (video encoding, 3D and build tools, headless browsers, busy scripts, what an AI coding agent started) is slowed down only when one of these limits is crossed for about the time below AND that work is part of the load. It is put back when everything has been calm for a while, or when the game closes. Priority only: nothing is ever stopped."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Total CPU load at or above (%)" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGCpu" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="GPU load at or above (%)" Grid.Row="1" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGGpu" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Available RAM below (GB)" Grid.Row="2" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGRam" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Game threads waiting for a core at or above (%, 0 = ignore)" Grid.Row="3" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="TbGReady" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Must last about (seconds)" Grid.Row="4" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGSecs" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Put back after this much calm (seconds)" Grid.Row="5" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="TbGRel" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" LostFocus="OnChanged"/>
                        <TextBlock Text="Background work must account for at least (% of CPU or GPU)" Grid.Row="6" Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="TbGMin" Grid.Row="6" Grid.Column="1" LostFocus="OnChanged"/>
                    </Grid>
                    <CheckBox x:Name="SwBelowNormal" Style="{StaticResource Switch}" Margin="0,12,0,0" Content="Use Below Normal instead of Idle priority" Click="OnChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Game detection" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Steam, Epic, GOG, Riot, Ubisoft, EA and Xbox library folders are recognised automatically, and so is any unknown program that runs in true fullscreen with the GPU busy. Add other game folders here, one per line."
                               Style="{StaticResource Caption}" Margin="0,6,0,6" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBox x:Name="TbGameFolders" AcceptsReturn="True" MinHeight="48" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Game Mode: what counts as background work" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Program names without .exe, one per line. Headless Chrome, Chromium and Edge (started with --headless) always count. Delete a line to leave that program alone."
                               Style="{StaticResource Caption}" Margin="0,6,0,6" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock Text="Encoders, 3D tools and build tools" Style="{StaticResource Faint}" Margin="0,4,0,4"/>
                    <TextBox x:Name="TbBackground" AcceptsReturn="True" MinHeight="96" MaxHeight="150" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                    <TextBlock Text="Script runtimes (count only when they really use the CPU)" Style="{StaticResource Faint}" Margin="0,12,0,4"/>
                    <TextBox x:Name="TbRuntimes" AcceptsReturn="True" MinHeight="64" MaxHeight="120" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                    <TextBlock Text="AI coding agents (everything an agent started, such as its builds, renders and browsers, counts)" Style="{StaticResource Faint}" Margin="0,12,0,4"/>
                    <TextBox x:Name="TbAgents" AcceptsReturn="True" MinHeight="48" MaxHeight="100" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                    <Button Content="Restore these three lists to the defaults" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnResetBackground"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Disk cleaner: extra folders to scan" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Besides the built-in list (temp files, browser and package caches, shader caches, crash dumps), the cleaner can look at folders of your own. One per line: folder pattern | label | idle days (the last two are optional). A * works inside one folder name, ** means any number of folders, and well-known variables such as %LOCALAPPDATA% or %USERPROFILE% work. Idle days: only offer a folder that has not changed for that long. Every match is offered as one item, goes to the Recycle Bin, and protected folders are still refused."
                               Style="{StaticResource Caption}" Margin="0,6,0,6" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBox x:Name="TbScan" AcceptsReturn="True" MinHeight="64" MaxHeight="150" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                    <TextBlock Text="Examples:   D:\Projects\*\build | Build output       D:\Projects\**\node_modules | node_modules | 30" Style="{StaticResource Faint}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Disk cleaner: protected folders" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Always protected (cannot be switched off):" Style="{StaticResource Caption}" Margin="0,6,0,4"/>
                    <TextBlock x:Name="BuiltInProtected" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" LineHeight="19"/>
                    <TextBlock Text="Add your own, one per line. The cleaner never touches these folders or anything inside them, and refuses a folder that contains one. Write full paths: a drive letter, then folder names, where * stands for part of a name, ? for one character and ** for any number of folders, for example D:\Projects\**\src. A relative path or a bare folder name would protect nothing, so it is ignored and flagged below."
                               Style="{StaticResource Caption}" Margin="0,12,0,6" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBox x:Name="TbProtected" AcceptsReturn="True" MinHeight="64" MaxHeight="150" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="OnChanged"/>
                    <TextBlock x:Name="ProtectedWarn" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" LineHeight="19" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="StatusBlock" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open data folder" Style="{StaticResource PillButton}" Click="OnOpenData"/>
                        <Button Content="Export settings..." Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="OnExport"/>
                        <Button Content="Import settings..." Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="OnImport"/>
                    </StackPanel>
                    <TextBlock x:Name="ImportResult" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
