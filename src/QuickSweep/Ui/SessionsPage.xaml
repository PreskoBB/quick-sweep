<UserControl x:Class="QuickSweep.Ui.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28">
            <TextBlock Text="Sessions" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="One entry per game: how your PC behaved while you played. The last 20 are shown."
                       Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" TextTrimming="None"/>

            <Border x:Name="LiveCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed" BorderBrush="#2F5F7A" Background="#1F3340">
                <StackPanel>
                    <TextBlock x:Name="LiveTitle" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="LiveLine" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                       Text="No games recorded yet. Start a game and close it again: Quick Sweep keeps the temperatures, loads, memory peak, throttling and ping spikes of that session here. Sessions shorter than a minute are ignored."/>

            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding VerdictBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Game}" Style="{StaticResource SectionTitle}" FontSize="15" Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontSize="12" Margin="19,2,0,10"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="CPU temperature" Style="{StaticResource Faint}"/><TextBlock Text="{Binding CpuTemp}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="GPU temperature" Style="{StaticResource Faint}"/><TextBlock Text="{Binding GpuTemp}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,8"><TextBlock Text="Load (peak)" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Loads}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,0,8"><TextBlock Text="Played" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Duration}" Style="{StaticResource Body}"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Memory (peak)" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Memory}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Thermal throttling" Style="{StaticResource Faint}"/><TextBlock Text="{Binding Throttle}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Router ping" Style="{StaticResource Faint}"/><TextBlock Text="{Binding RouterLine}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel><TextBlock Text="Internet ping (1.1.1.1)" Style="{StaticResource Faint}"/><TextBlock Text="{Binding NetLine}" Style="{StaticResource Body}" TextTrimming="None" TextWrapping="Wrap"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding PingTrouble}" Visibility="{Binding PingTroubleVis}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Extra}" Visibility="{Binding ExtraVis}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
