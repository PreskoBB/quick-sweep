<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette (Windows 11 dark, slightly cool) -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E1F24"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#26272D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2C2D34"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#34353D"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#3B3C45"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A6A6B0"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#7E7F8C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFC83D"/>
    <SolidColorBrush x:Key="BadBrush" Color="#FF6B6B"/>
    <!-- make the Fluent controls (sliders, focus) use the app accent instead of the system accent colour -->
    <Color x:Key="SystemAccentColor">#60CDFF</Color>
    <Color x:Key="SystemAccentColorPrimary">#60CDFF</Color>
    <Color x:Key="SystemAccentColorSecondary">#4CC2F5</Color>
    <Color x:Key="SystemAccentColorTertiary">#3AA8DB</Color>
    <Color x:Key="SystemAccentColorLight1">#8FDDFF</Color>
    <Color x:Key="SystemAccentColorLight2">#A9E5FF</Color>
    <Color x:Key="SystemAccentColorLight3">#C4EEFF</Color>
    <Color x:Key="SystemAccentColorDark1">#3AA8DB</Color>
    <Color x:Key="SystemAccentColorDark2">#2B8BB9</Color>
    <Color x:Key="SystemAccentColorDark3">#1E6D93</Color>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#363741"/>
        <Setter Property="BorderBrush" Value="#464753"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#60CDFF"/>
        <Setter Property="BorderBrush" Value="#60CDFF"/>
        <Setter Property="Foreground" Value="#06202E"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#5C2B31"/>
        <Setter Property="BorderBrush" Value="#7A3A41"/>
        <Setter Property="Foreground" Value="#FFC2C2"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Toggle switch (CheckBox) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="10" Background="#44454F" BorderBrush="#7A7B88" BorderThickness="1"/>
                            <Ellipse x:Name="thumb" Width="12" Height="12" Fill="#D6D6DE" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#60CDFF"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="#60CDFF"/>
                            <Setter TargetName="thumb" Property="Fill" Value="#06202E"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation item (RadioButton) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,1" Height="38">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent"/>
                        <Border x:Name="pip" Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Margin="0" Visibility="Collapsed"/>
                        <ContentPresenter VerticalAlignment="Center" Margin="16,0,8,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2B2C33"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33343C"/>
                            <Setter TargetName="pip" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
