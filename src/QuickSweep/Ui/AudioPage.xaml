<UserControl x:Class="QuickSweep.Ui.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Audio" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" TextTrimming="None"
                       Text="Switch the output device and check the Windows volume mixer. An app sitting below 100% in the mixer is quieter than it needs to be, whatever your speakers or sound card can do."/>

            <Border x:Name="FlagCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10" Background="#3A2F14" BorderBrush="#6B5420" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Quiet on purpose?" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="FlagText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Output device" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="DeviceList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Height="32">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="10,0,0,0" FontWeight="{Binding Weight}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Make default" Style="{StaticResource PillButton}" Padding="12,4" Visibility="{Binding SwitchVis}" Tag="{Binding}" Click="OnMakeDefault"/>
                                    <TextBlock Grid.Column="1" Text="Default" Style="{StaticResource Caption}" VerticalAlignment="Center" Visibility="{Binding DefaultVis}" Margin="0,0,6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoDevices" Visibility="Collapsed" Style="{StaticResource Caption}" Text="No active output devices found."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Volume" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,10,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Output device (master)" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <Slider x:Name="MasterSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnMasterChanged"/>
                        <TextBlock x:Name="MasterText" Grid.Column="2" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource StrokeBrush}" Margin="0,8,0,6"/>
                    <TextBlock Text="Apps that have played sound (Windows volume mixer)" Style="{StaticResource Faint}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"/>
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Faint}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=TwoWay}" Tag="{Binding}" ValueChanged="OnSessionChanged" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Foreground="{Binding PercentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="Set to 100%" Style="{StaticResource PillButton}" Padding="10,3" FontSize="11" Margin="10,0,0,0" Visibility="{Binding FixVis}" Tag="{Binding}" Click="OnFix"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSessions" Visibility="Collapsed" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Text="No app has opened an audio session yet. Play something and it shows up here."/>
                    <TextBlock Style="{StaticResource Faint}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                               Text="This is the level in the Windows mixer. An app can also have its own volume slider inside (for example Spotify's); that one is not visible to Windows."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
